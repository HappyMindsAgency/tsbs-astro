---
import { marked } from "marked";
import sanitizeHtml from "sanitize-html";
const { block, className, pstyle }  = Astro.props;
const rawHtml = block ? await marked(block, { breaks: true, gfm: true }) : "nothing";
// Sanitizzazione XSS: rich text arriva da input utente (es. note Grimorio) senza
// controlli lato scrittura. Deve restare server-side e compatibile con Vercel.
const content = block
    ? sanitizeHtml(rawHtml, {
        allowedTags: ["b", "i", "strong", "em", "u", "s", "p", "br", "ul", "ol", "li", "a", "h1", "h2", "h3", "h4", "blockquote", "code", "pre"],
        allowedAttributes: { a: ["href"] },
        allowedSchemes: ["http", "https", "mailto"],
        allowProtocolRelative: false,
      })
    : rawHtml;
---
{block && 
<div class={`block-richtext custombody ${className}`} set:html={content}></div>
}

{pstyle && 
<style>
    .block-richtext.custombody p {
        ${pstyle}
    }
</style>
}
