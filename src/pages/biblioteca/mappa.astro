---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import MappaLuoghi from '../../components/PopupComponents/MappaLuoghi.astro';
import { resolveUserContext } from '../../lib/theme';
import { getMappaContent } from '../../lib/strapi/mappa';
import pianoTerraImage from '../../assets/mappa_pianoterra_00.jpg';
import pianoPrimoImage from '../../assets/mappa_piano_primo_01.jpg';
import pianoSecondoImage from '../../assets/mappa_piano_secondo_02.jpg';

const { lang = 'it' } = Astro.props;
const jwt = Astro.cookies.get('jwt')?.value;

if (!jwt) {
	return Astro.redirect('/');
}

const { theme, accademia } = await resolveUserContext(jwt);
const mappa = await getMappaContent(lang);
const mapTitle = mappa.titolo;
const hotspots = mappa.hotspots;

const mapFloors = [
	{
		id: 'piano-terra',
		label: 'Piano terra',
		image: pianoTerraImage,
		alt: 'Mappa della Biblioteca Classense al piano terra',
		hotspots: hotspots.filter((hotspot) => hotspot.piano === 'piano-terra'),
	},
	{
		id: 'piano-primo',
		label: 'Piano primo',
		image: pianoPrimoImage,
		alt: 'Mappa della Biblioteca Classense al piano primo',
		hotspots: hotspots.filter((hotspot) => hotspot.piano === 'piano-primo'),
	},
	{
		id: 'piano-secondo',
		label: 'Piano secondo',
		image: pianoSecondoImage,
		alt: 'Mappa della Biblioteca Classense al piano secondo',
		hotspots: hotspots.filter((hotspot) => hotspot.piano === 'piano-secondo'),
	},
];
---

<Layout lang={lang} theme={theme} accademia={accademia}>
	<Nav lang={lang} />
	<MappaLuoghi />

	<main class="tsbs-app-shell missions-shell biblioteca-page biblioteca-map-page">
		<header class="missions-header biblioteca-header">
			<h1>{mapTitle}</h1>
		</header>

		<section class="container-xl tsbs-app-container biblioteca-content" aria-labelledby="biblioteca-map-page-title">
			<h2 id="biblioteca-map-page-title" class="visually-hidden">{mapTitle}</h2>

			<div class="biblioteca-intro">
				<p>	Hai già scoperto quali stanze custodiscono il sapere e la memoria della Società? Sai orientarti con facilità tra corridoi, chiostri e sale? </p>

					<p>Questa mappa ti guiderà attraverso i tre piani della Biblioteca Classense, aiutandoti a riconoscere i luoghi in cui la Società ha preso forma e dove la storia ha avuto inizio. </p>

					<p>La Società ha lasciato tracce, simboli, segreti e indizi. 
					Osserva con attenzione. Esplora la mappa!</p>
				</p>
			</div>

			<section class="biblioteca-map-viewer" aria-label="Mappa della Biblioteca Classense" data-map-viewer>
				<div class="biblioteca-map-viewer__tabs" role="tablist" aria-label="Seleziona un piano">
					{mapFloors.map((floor, index) => (
						<button
							id={`map-tab-${floor.id}`}
							class="biblioteca-map-viewer__tab"
							type="button"
							role="tab"
							aria-selected={index === 0 ? 'true' : 'false'}
							aria-controls="map-panel"
							tabindex={index === 0 ? 0 : -1}
							data-map-tab
							data-floor-id={floor.id}
							data-image-src={floor.image.src}
							data-image-alt={floor.alt}
						>
							{floor.label}
						</button>
					))}
				</div>

				<div id="map-panel" class="biblioteca-map-viewer__panel" role="tabpanel" aria-labelledby="map-tab-piano-terra" tabindex="0">
					<img
						class="biblioteca-map-viewer__image"
						src={mapFloors[0].image.src}
						width={mapFloors[0].image.width}
						height={mapFloors[0].image.height}
						alt={mapFloors[0].alt}
						data-map-image
					/>
					<div class="biblioteca-map-viewer__hotspots" data-map-hotspots>
						{mapFloors.flatMap((floor) => floor.hotspots.map((hotspot) => (
							<button
								id={hotspot.id}
								class="biblioteca-map-viewer__hotspot"
								type="button"
								style={`left: ${hotspot.x}%; top: ${hotspot.y}%;`}
								data-map-hotspot
								data-floor-id={floor.id}
								data-map-place-title={hotspot.titolo}
								data-map-place-description={hotspot.contenuto}
								data-map-place-image-src={hotspot.immagineUrl || undefined}
								data-map-place-image-alt={hotspot.immagineAlt}
								aria-label={`Apri le informazioni su ${hotspot.titolo}`}
								hidden={floor.id !== 'piano-terra'}
							>
								<span class="visually-hidden">Apri le informazioni su {hotspot.titolo}</span>
							</button>
						)))}
					</div>
				</div>
			</section>
		</section>
	</main>
</Layout>

<script>
	const initMapViewer = () => {
		document.querySelectorAll<HTMLElement>('[data-map-viewer]').forEach((viewer) => {
			if (viewer.dataset.mapViewerInitialized === 'true') return;
			viewer.dataset.mapViewerInitialized = 'true';

			const tabs = Array.from(viewer.querySelectorAll<HTMLButtonElement>('[data-map-tab]'));
			const image = viewer.querySelector<HTMLImageElement>('[data-map-image]');
			const panel = viewer.querySelector<HTMLElement>('[role="tabpanel"]');
			const hotspots = viewer.querySelector<HTMLElement>('[data-map-hotspots]');

			if (!image || !panel || tabs.length === 0) return;

			const selectTab = (tab: HTMLButtonElement, shouldFocus = false) => {
				tabs.forEach((candidate) => {
					const isSelected = candidate === tab;
					candidate.setAttribute('aria-selected', String(isSelected));
					candidate.tabIndex = isSelected ? 0 : -1;
				});

				image.src = tab.dataset.imageSrc || image.src;
				image.alt = tab.dataset.imageAlt || '';
				panel.setAttribute('aria-labelledby', tab.id);
				hotspots?.querySelectorAll<HTMLElement>('[data-map-hotspot]').forEach((hotspot) => {
					hotspot.hidden = hotspot.dataset.floorId !== tab.dataset.floorId;
				});

				if (shouldFocus) tab.focus();
			};

			tabs.forEach((tab, index) => {
				tab.addEventListener('click', () => selectTab(tab));
				tab.addEventListener('keydown', (event) => {
					const offsets: Record<string, number> = {
						ArrowRight: 1,
						ArrowDown: 1,
						ArrowLeft: -1,
						ArrowUp: -1,
					};

					if (event.key === 'Home') {
						event.preventDefault();
						selectTab(tabs[0], true);
						return;
					}

					if (event.key === 'End') {
						event.preventDefault();
						selectTab(tabs[tabs.length - 1], true);
						return;
					}

					const offset = offsets[event.key];
					if (!offset) return;

					event.preventDefault();
					selectTab(tabs[(index + offset + tabs.length) % tabs.length], true);
				});
			});

			viewer.querySelectorAll<HTMLButtonElement>('[data-map-hotspot]').forEach((hotspot) => {
				hotspot.addEventListener('click', () => {
					window.dispatchEvent(
						new CustomEvent('tsbs:map-place-open', {
								detail: {
									trigger: hotspot,
									title: hotspot.dataset.mapPlaceTitle,
									description: hotspot.dataset.mapPlaceDescription,
									imageSrc: hotspot.dataset.mapPlaceImageSrc,
									imageAlt: hotspot.dataset.mapPlaceImageAlt,
							},
						}),
					);
				});
			});
		});
	};

	initMapViewer();
	document.addEventListener('astro:page-load', initMapViewer);
</script>
